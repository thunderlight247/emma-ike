# Public site URL (used for metadata, structured data and Paystack callback)
NEXT_PUBLIC_SITE_URL=https://www.emma-ikeguesthouse.com

# WhatsApp number in international format, digits only (no +, spaces or leading 0)
NEXT_PUBLIC_WHATSAPP_NUMBER=233244754107

# Paystack (leave empty to hide online payment; WhatsApp booking keeps working)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Optional: a Google Maps embed URL from Google Maps > Share > Embed a map.
# If empty, the site uses a keyless embed centred on the guesthouse coordinates.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
